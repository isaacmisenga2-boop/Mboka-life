
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#172b24">
  <title>MBOKA LIFE</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      overflow: hidden;
      background: #172b24;
      color: white;
      font-family: Arial, sans-serif;
    }

    #game {
      display: block;
      width: 100vw;
      height: 100vh;
      touch-action: none;
    }

    #hud {
      position: fixed;
      top: 15px;
      left: 15px;
      padding: 12px 16px;
      border-radius: 12px;
      background: #10251dcc;
      border: 1px solid #ffffff33;
      pointer-events: none;
    }

    #hud h1 {
      margin: 0 0 5px;
      font-size: 20px;
      letter-spacing: 2px;
    }

    #hud p {
      margin: 0;
      color: #c9e5d1;
      font-size: 12px;
    }

    #message {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: 90%;
      padding: 10px 15px;
      border-radius: 10px;
      background: #10251dcc;
      font-size: 13px;
      text-align: center;
      pointer-events: none;
    }
  </style>
</head>

<body>
  <canvas id="game"></canvas>

  <div id="hud">
    <h1>MBOKA LIFE</h1>
    <p>MWANGAZA — Construction du monde</p>
  </div>

  <div id="message">
    Utilise les flèches ou ZQSD pour déplacer le personnage.
  </div>

  <script>
    (() => {
      "use strict";

      const canvas = document.getElementById("game");
      const ctx = canvas.getContext("2d");

      if (!ctx) {
        document.getElementById("message").textContent =
          "Erreur : impossible de démarrer le moteur graphique.";
        return;
      }

      const player = {
        x: 0,
        y: 0,
        speed: 3,
        direction: 1
      };

      const keys = {};

      function resize() {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.floor(innerWidth * ratio);
        canvas.height = Math.floor(innerHeight * ratio);

        canvas.style.width = innerWidth + "px";
        canvas.style.height = innerHeight + "px";

        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      }

      function drawHouse(x, y, color) {
        ctx.fillStyle = color;
        ctx.fillRect(x, y, 110, 85);

        ctx.fillStyle = "#693e2c";
        ctx.beginPath();
        ctx.moveTo(x - 10, y);
        ctx.lineTo(x + 55, y - 45);
        ctx.lineTo(x + 120, y);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = "#513526";
        ctx.fillRect(x + 43, y + 42, 25, 43);

        ctx.fillStyle = "#a9d8e5";
        ctx.fillRect(x + 10, y + 20, 23, 20);
        ctx.fillRect(x + 77, y + 20, 23, 20);
      }

      function drawPerson(x, y) {
        ctx.save();
        ctx.translate(x, y);

        // Ombre
        ctx.fillStyle = "#00000033";
        ctx.beginPath();
        ctx.ellipse(0, 22, 15, 6, 0, 0, Math.PI * 2);
        ctx.fill();

        // Jambes
        ctx.strokeStyle = "#292b38";
        ctx.lineWidth = 7;
        ctx.lineCap = "round";

        ctx.beginPath();
        ctx.moveTo(-5, 5);
        ctx.lineTo(-7, 19);
        ctx.moveTo(5, 5);
        ctx.lineTo(7, 19);
        ctx.stroke();

        // Corps
        ctx.fillStyle = "#2877a8";
        ctx.beginPath();
        ctx.roundRect(-11, -19, 22, 27, 7);
        ctx.fill();

        // Bras
        ctx.strokeStyle = "#8a573b";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(-10, -13);
        ctx.lineTo(-16, 1);
        ctx.moveTo(10, -13);
        ctx.lineTo(16, 1);
        ctx.stroke();

        // Cou et tête
        ctx.fillStyle = "#8a573b";
        ctx.fillRect(-4, -24, 8, 8);

        ctx.beginPath();
        ctx.arc(0, -32, 11, 0, Math.PI * 2);
        ctx.fill();

        // Cheveux
        ctx.fillStyle = "#171412";
        ctx.beginPath();
        ctx.arc(0, -36, 10, Math.PI, Math.PI * 2);
        ctx.fill();

        // Visage
        ctx.fillStyle = "#171412";
        ctx.beginPath();
        ctx.arc(-4, -32, 1.3, 0, Math.PI * 2);
        ctx.arc(4, -32, 1.3, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = "#512c22";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(0, -28, 3, 0.2, Math.PI - 0.2);
        ctx.stroke();

        ctx.restore();
      }

      function update() {
        const dx =
          (keys["ArrowRight"] || keys["d"] ? 1 : 0) -
          (keys["ArrowLeft"] || keys["q"] ? 1 : 0);

        const dy =
          (keys["ArrowDown"] || keys["s"] ? 1 : 0) -
          (keys["ArrowUp"] || keys["z"] ? 1 : 0);

        const length = Math.hypot(dx, dy) || 1;

        player.x += dx / length * player.speed;
        player.y += dy / length * player.speed;

        player.x = Math.max(-250, Math.min(250, player.x));
        player.y = Math.max(-150, Math.min(150, player.y));

        if (dx !== 0) player.direction = Math.sign(dx);
      }

      function draw() {
        const w = innerWidth;
        const h = innerHeight;

        ctx.clearRect(0, 0, w, h);

        // Sol
        ctx.fillStyle = "#8a9b64";
        ctx.fillRect(0, 0, w, h);

        // Route
        ctx.fillStyle = "#77766f";
        ctx.fillRect(0, h * 0.55, w, 95);

        ctx.strokeStyle = "#e4d8a0";
        ctx.setLineDash([25, 20]);
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(0, h * 0.55 + 47);
        ctx.lineTo(w, h * 0.55 + 47);
        ctx.stroke();
        ctx.setLineDash([]);

        // Décor
        const offsetX = w / 2 - player.x;
        const offsetY = h / 2 - player.y;

        drawHouse(offsetX - 230, offsetY - 140, "#d9a46e");
        drawHouse(offsetX + 100, offsetY - 130, "#d9d0b0");
        drawHouse(offsetX - 230, offsetY + 100, "#c77d62");
        drawHouse(offsetX + 140, offsetY + 110, "#d6b56e");

        // Arbres
        for (const [x, y] of [
          [-300, -70], [300, -70], [-300, 180], [300, 180]
        ]) {
          ctx.fillStyle = "#69452b";
          ctx.fillRect(offsetX + x - 5, offsetY + y, 10, 35);
          ctx.fillStyle = "#286b3d";
          ctx.beginPath();
          ctx.arc(offsetX + x, offsetY + y, 24, 0, Math.PI * 2);
          ctx.fill();
        }

        // Personnage au centre
        drawPerson(w / 2, h / 2);
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }

      window.addEventListener("keydown", e => {
        keys[e.key] = true;

        if ([
          "ArrowUp", "ArrowDown",
          "ArrowLeft", "ArrowRight", " "
        ].includes(e.key)) {
          e.preventDefault();
        }
      });

      window.addEventListener("keyup", e => {
        keys[e.key] = false;
      });

      window.addEventListener("blur", () => {
        for (const key in keys) keys[key] = false;
      });

      window.addEventListener("resize", resize);

      resize();
      loop();
    })();
  </script>
</body>
</html>
