
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: Arial, sans-serif;
  background: #17251e;
  color: white;
}

#game {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}

#hud {
  position: fixed;
  top: 14px;
  left: 14px;
  z-index: 10;
  padding: 12px 16px;
  border: 1px solid #ffffff35;
  border-radius: 12px;
  background: #10251dcc;
  pointer-events: none;
}

#hud h1 {
  font-size: 20px;
  letter-spacing: 2px;
}

#hud p {
  margin-top: 5px;
  color: #c9e5d1;
  font-size: 12px;
}

#message {
  position: fixed;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  width: max-content;
  max-width: 90%;
  padding: 10px 15px;
  border-radius: 10px;
  background: #10251dcc;
  text-align: center;
  font-size: 13px;
  pointer-events: none;
}

@media (max-width: 600px) {
  #hud {
    top: 10px;
    left: 10px;
    padding: 9px 12px;
  }

  #hud h1 {
    font-size: 17px;
  }

  #message {
    bottom: 12px;
    font-size: 11px;
  }
}
